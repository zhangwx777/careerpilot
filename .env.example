# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会进版本库。

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg://qiuzhao_app:<密码>@127.0.0.1:5432/qiuzhao
# 集成测试库（可选；配置后 pytest 才会连接真实 PostgreSQL）
TEST_DATABASE_URL=postgresql+psycopg://qiuzhao_app:<密码>@127.0.0.1:5432/qiuzhao_test

# ---- 大模型配置 ----
# 模型只在启动后打开“模型配置”页填写，后端不从 .env 读取 provider 配置。

# ---- 可选：公开网页检索 ----
# 不配置时模型分析仍可使用本机已有资料，但“联网补充”和公开面经搜索会跳过。
ANYSEARCH_API_KEY=
