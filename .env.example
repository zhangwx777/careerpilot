# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会进版本库。

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg://qiuzhao_app:qiuzhao_dev@postgres:5432/qiuzhao
# 集成测试库（可选；配置后 pytest 才会连接真实 PostgreSQL）
TEST_DATABASE_URL=postgresql+psycopg://qiuzhao_app:qiuzhao_dev@postgres:5432/qiuzhao_test

# ---- 大模型配置 ----
# 模型只在启动后打开“模型配置”页填写，后端不从 .env 读取 provider 配置。

# ---- Agent 后台任务队列 ----
# CareerPilot 的面经问答、备战分析和洞察重建由 Celery worker 执行。
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIMEOUT=180
CELERY_MAX_RETRIES=2
# 单元测试可设为 true；生产环境保持 false 并启动独立 worker。
CELERY_TASK_ALWAYS_EAGER=false
