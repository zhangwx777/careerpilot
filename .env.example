# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会进版本库。

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg://qiuzhao_app:<密码>@127.0.0.1:5432/qiuzhao
# 集成测试库（可选；配置后 pytest 才会连接真实 PostgreSQL）
TEST_DATABASE_URL=postgresql+psycopg://qiuzhao_app:<密码>@127.0.0.1:5432/qiuzhao_test

# ---- 大模型配置 ----
# .env 兼容模式可填写每家三件套：API_KEY / BASE_URL / MODEL。
# 推荐启动后进入“模型配置”：填写 API Key 与 Base URL，点击“读取模型”后从目录选择模型。
# 只填你要用的厂商；key 为空的厂商会被视为未配置。
# MODEL 用 LiteLLM 格式：provider/model，如 deepseek/deepseek-chat；网页配置会覆盖同名 .env 值。
# BASE_URL 留空则用 LiteLLM 官方默认（走中转/自建时填写 API 根路径）

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Qwen 使用 DashScope 环境变量名
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# 网页保存模型配置时使用；留空则保持旧的 .env-only 模式。
# 可填写任意长的本地秘密字符串，不要提交到 git。
LLM_CONFIG_SECRET=
